# .env.example - Environment variables template
# Copy to .env and fill in your actual values

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgres://bot:secure_password@localhost:5432/aviasales_db
DB_PASSWORD=secure_password
DB_MAX_CONNECTIONS=20
DB_QUERY_TIMEOUT=30s

# ============================================================================
# REDIS
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# EXTERNAL APIS
# ============================================================================
AVIASALES_API_KEY=your_aviasales_api_key_here
OPENAI_API_KEY=sk-your_openai_key_here
TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ============================================================================
# TELEGRAM
# ============================================================================
# Получить ID канала:
# 1. Добавить бота в канал как администратора
# 2. Отправить любое сообщение в канал
# 3. Сделать: curl "https://api.telegram.org/botТОКЕН/getUpdates"
# Найти negative number в "chat":{"id": -1001234567890}
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/webhook/telegram

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================
LOG_LEVEL=info                    # debug, info, warn, error
PARSER_INTERVAL=30m               # Интервал парсинга Aviasales
RANKER_INTERVAL=3h                # Интервал ранжирования и публикации
ENVIRONMENT=development           # development, staging, production

# ============================================================================
# LLM CONFIGURATION
# ============================================================================
LLM_PROVIDER=openai               # openai или anthropic
LLM_MODEL=gpt-4-turbo            # gpt-4-turbo, gpt-3.5-turbo, claude-opus, etc.
LLM_TEMPERATURE=0.7               # 0-1, выше = более креативно
LLM_MAX_TOKENS=500

# ============================================================================
# API SERVER
# ============================================================================
PORT=8080
HOST=0.0.0.0

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
SENTRY_DSN=https://key@sentry.io/project-id
PROMETHEUS_PORT=9090
LOG_FORMAT=json                   # json или text
LOG_OUTPUT=stdout                 # stdout или файл

# ============================================================================
# GRAFANA (UI DASHBOARDS)
# ============================================================================
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000

# ============================================================================
# PGADMIN (DATABASE MANAGEMENT)
# ============================================================================
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_ANALYTICS=true
ENABLE_USER_PREFERENCES=true
ENABLE_WEBHOOK_VALIDATION=true

# ============================================================================
# BUSINESS RULES
# ============================================================================
MIN_DISCOUNT_PERCENT=20           # Минимальный % скидки для публикации
MIN_ROUTE_REPUBLISH_HOURS=48      # Минимум часов между публикациями одного маршрута
MIN_DAYS_BEFORE_FLIGHT=1          # Минимум дней до вылета
TOP_FLIGHTS_TO_PUBLISH=10         # Сколько билетов публиковать за раз

# ============================================================================
# DEVELOPER OPTIONS
# ============================================================================
DEBUG=false
MOCK_AVIASALES=false              # Для тестирования без API
MOCK_LLM=false                    # Для тестирования без OpenAI
DRY_RUN=false                     # Не публикует в Telegram (только логирует)
